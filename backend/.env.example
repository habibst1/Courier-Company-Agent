# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real values.

# --- LLM (Groq) ---------------------------------------------------------------
GROQ_API_KEY=
# Any init_chat_model id works, e.g. groq:openai/gpt-oss-120b
MODEL=groq:openai/gpt-oss-20b
# Optional: a separate (often stronger) model for the SQL sub-agent
# SQL_MODEL=groq:openai/gpt-oss-120b
TEMPERATURE=0

# --- Database ------------------------------------------------------------------
# Superuser URL. Only scripts/setup_db.py uses it, to create roles, views and demo logins.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/courier_db
# Sandbox role for LLM-written SQL: can only read the scoped agent.* views.
AGENT_DATABASE_URL=postgresql://courier_agent:CHANGE_ME@localhost:5432/courier_db
# App role: binds query scopes, checks logins, stores chat memory (checkpoints schema).
APP_DATABASE_URL=postgresql://courier_app:CHANGE_ME@localhost:5432/courier_db
SQL_TIMEOUT_SECONDS=8
SQL_MAX_ROWS=50

# --- Logins and sessions -------------------------------------------------------
# Password that setup_db.py gives every demo customer (sign in with their username).
DEMO_PASSWORD=CHANGE_ME
# Long random string used to sign login and chat-session tokens.
SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE_HOURS=24
LOGIN_MAX_AGE_HOURS=12

# --- Conversation memory ---------------------------------------------------------
# postgres keeps chats across restarts; memory is handy for quick experiments.
CHECKPOINTER=postgres
# Summarize older messages once a thread passes this many tokens, keeping the latest N messages.
SUMMARY_TRIGGER_TOKENS=4000
SUMMARY_KEEP_MESSAGES=20

# --- HTTP -------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
